---
import { getCollection, render } from 'astro:content';
import Guide from '@/layouts/Guide.astro';
import { loadGuides, moreGuides, pathOf, slugOf } from '@/lib/guides';
import { site } from '@/lib/site';
export async function getStaticPaths() {
  return (await getCollection('guides')).map(entry => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const related = moreGuides(await loadGuides(), entry);
const updated = entry.data.updated.toISOString().slice(0, 10);
const article = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  dateModified: updated,
  publisher: { '@type': 'Organization', name: site.parent.name, url: site.parent.url },
  mainEntityOfPage: new URL(pathOf(entry), site.url).href,
}).replace(/</g, '\\u003c');
const breadcrumbs = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: new URL('/guides', site.url).href },
    { '@type': 'ListItem', position: 3, name: entry.data.title, item: new URL(pathOf(entry), site.url).href },
  ],
}).replace(/</g, '\\u003c');
---
<Guide title={entry.data.title} description={entry.data.description} headings={headings} related={related}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={article} />
    <script is:inline type="application/ld+json" set:html={breadcrumbs} />
  </Fragment>
  <p class="docs-platform">Updated <time datetime={updated}>{entry.data.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p>
  <Content />
</Guide>
