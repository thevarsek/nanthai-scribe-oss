---
import { getCollection, render } from 'astro:content';
import Docs from '@/layouts/Docs.astro';
import { slugOf } from '@/lib/docs';
export async function getStaticPaths() {
  return (await getCollection('docs')).map(entry => ({ params: { slug: entry.id.replace(/^en\//, '') }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const platform = entry.data.platform;
---
<Docs title={entry.data.title} description={entry.data.description} slug={slugOf(entry)} headings={headings}>
<h1>{entry.data.title}</h1>
<p class="lede">{entry.data.description}</p>
{platform !== 'both' && <p class="docs-platform">{platform === 'mac' ? 'Mac only.' : 'iPhone only.'}</p>}
<Content />
</Docs>
