---
import { site } from '@/lib/site';
const { platform } = Astro.props;
// A platform that hasn't shipped shows a disabled "Coming soon"; the URLs stay in site.ts.
const macSoon = !site.launched.mac;
const iphoneSoon = !site.launched.iphone;
---
<div class="cta-row">
  {platform !== 'iphone' && <div class="store-option">
    {macSoon ? <span class="btn primary lg" aria-disabled="true">Coming soon</span> : <a class="btn primary lg" href={site.downloads.mac}>Download for Mac</a>}
    <p class="muted small">{macSoon ? 'Mac · macOS 26 · Apple silicon' : 'macOS 26 · Apple silicon'}</p></div>}
  {platform !== 'mac' && (iphoneSoon
    ? <div class="store-option"><span class:list={['btn lg', platform === 'iphone' ? 'primary' : 'ghost']} aria-disabled="true">Coming soon</span><p class="muted small">iPhone · App Store</p></div>
    : <div class="store-option"><a class="store-badge" href={site.stores.iphone}><img src="/badges/app-store.svg" alt="Download on the App Store" width="162" height="54"></a><p class="muted small">iPhone · iOS 26</p></div>)}
</div>
