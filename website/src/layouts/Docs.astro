---
import Base from './Base.astro';
import { loadDocs, pathOf, slugOf, platformLabel } from '@/lib/docs';
import '@/styles/docs.css';
interface Props { title: string; description: string; slug: string; headings?: { depth: number; slug: string; text: string }[]; wide?: boolean; }
const { title, description, slug, headings = [], wide = false } = Astro.props;
const { entries, grouped, index } = await loadDocs();
const current = entries.findIndex(e => slugOf(e) === slug);
const previous = current > 0 ? entries[current - 1] : null;
const next = current >= 0 ? entries[current + 1] : null;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
// Inline JSON must not be able to close its own script element.
const indexJson = JSON.stringify(index).replace(/</g, '\\u003c');
---
<Base title={title} description={description}>
<div class="docs container">
  <aside class="docs-side">
    <form class="docs-search" role="search" autocomplete="off">
      <label class="sr-only" for="docs-q">Search the docs</label>
      <svg class="docs-search-icon" viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      <input id="docs-q" type="search" placeholder="Search docs" role="combobox" aria-expanded="false" aria-controls="docs-results" aria-autocomplete="list" aria-haspopup="listbox" enterkeyhint="go" />
      <ul id="docs-results" class="docs-results" role="listbox" aria-label="Search results" hidden></ul>
    </form>
    <button class="docs-toggle" aria-controls="docs-links" aria-expanded="false">Browse docs <span aria-hidden="true">+</span></button>
    <nav id="docs-links" class="docs-links" aria-label="Documentation">
      <a class="docs-home" href="/docs" aria-current={slug === '' ? 'page' : undefined}>All docs</a>
      {grouped.map(group => <section>
        <p>{group.label}</p>
        <ul>{group.entries.map(e => <li><a href={pathOf(e)} aria-current={slugOf(e) === slug ? 'page' : undefined}>{e.data.title}{e.data.platform !== 'both' && <span class="platform">{platformLabel(e.data.platform)}</span>}</a></li>)}</ul>
      </section>)}
    </nav>
  </aside>
  <article class:list={['docs-article', 'prose', { wide }]}>
    <slot />
    {(previous || next) && <nav class="pager" aria-label="Article navigation">
      {previous ? <a class="prev" href={pathOf(previous)}><span>Previous</span>{previous.data.title}</a> : <span></span>}
      {next && <a class="next" href={pathOf(next)}><span>Next</span>{next.data.title}</a>}
    </nav>}
  </article>
  {toc.length > 0 && <aside class="docs-toc"><nav aria-label="On this page">
    <p>On this page</p>
    <ul>{toc.map(h => <li class={'d' + h.depth}><a href={'#' + h.slug}>{h.text}</a></li>)}</ul>
  </nav></aside>}
</div>
<script is:inline type="application/json" id="docs-index" set:html={indexJson} />
</Base>
<script>
// Sidebar on small screens.
const button = document.querySelector<HTMLButtonElement>('.docs-toggle');
button?.addEventListener('click', () => {
  const open = button.getAttribute('aria-expanded') !== 'true';
  button.setAttribute('aria-expanded', String(open));
  document.getElementById('docs-links')?.classList.toggle('open', open);
});

// Search over titles and headings. The index is inlined at build time; nothing is fetched.
interface Hit { title: string; sub: string; href: string; score: number }
interface Doc { title: string; path: string; group: string; headings: { text: string; slug: string }[] }
const docs: Doc[] = JSON.parse(document.getElementById('docs-index')?.textContent || '[]');
const form = document.querySelector<HTMLFormElement>('.docs-search');
const input = document.getElementById('docs-q') as HTMLInputElement | null;
const list = document.getElementById('docs-results') as HTMLUListElement | null;
let hits: Hit[] = [], active = -1;
const fold = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
function search(query: string): Hit[] {
  const terms = fold(query).split(/\s+/).filter(Boolean);
  if (!terms.length) return [];
  const out: Hit[] = [];
  for (const doc of docs) {
    const title = fold(doc.title);
    if (terms.every(t => title.includes(t))) out.push({ title: doc.title, sub: doc.group, href: doc.path, score: title.startsWith(terms[0]) ? 3 : 2 });
    for (const h of doc.headings) {
      const heading = fold(h.text);
      if (terms.some(t => heading.includes(t)) && terms.every(t => heading.includes(t) || title.includes(t)))
        out.push({ title: h.text, sub: doc.title, href: doc.path + '#' + h.slug, score: 1 });
    }
  }
  return out.sort((a, b) => b.score - a.score).slice(0, 8);
}
function close() { if (!list || !input) return; list.hidden = true; list.innerHTML = ''; hits = []; active = -1; input.setAttribute('aria-expanded', 'false'); input.removeAttribute('aria-activedescendant'); }
function highlight(i: number) {
  if (!list || !input) return;
  active = i;
  list.querySelectorAll('li').forEach((li, n) => li.setAttribute('aria-selected', String(n === i)));
  if (i >= 0) input.setAttribute('aria-activedescendant', 'docs-hit-' + i); else input.removeAttribute('aria-activedescendant');
}
function show() {
  if (!list || !input) return;
  const query = input.value.trim();
  if (!query) { close(); return; }
  hits = search(query);
  list.innerHTML = '';
  if (!hits.length) { const li = document.createElement('li'); li.className = 'empty'; li.textContent = `No results for “${query}”`; list.append(li); }
  hits.forEach((hit, i) => {
    const li = document.createElement('li'); li.id = 'docs-hit-' + i; li.setAttribute('role', 'option'); li.setAttribute('aria-selected', 'false');
    const a = document.createElement('a'); a.href = hit.href; a.tabIndex = -1;
    a.append(hit.title); const sub = document.createElement('span'); sub.textContent = hit.sub; a.append(sub);
    li.append(a); list.append(li);
  });
  list.hidden = false; input.setAttribute('aria-expanded', 'true'); highlight(-1);
}
input?.addEventListener('input', show);
input?.addEventListener('focus', show);
input?.addEventListener('keydown', e => {
  if (list?.hidden && e.key !== 'Escape') return;
  if (e.key === 'ArrowDown') { e.preventDefault(); highlight(hits.length ? (active + 1) % hits.length : -1); }
  else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(hits.length ? (active - 1 + hits.length) % hits.length : -1); }
  else if (e.key === 'Enter') { e.preventDefault(); const hit = hits[active >= 0 ? active : 0]; if (hit) location.href = hit.href; }
  else if (e.key === 'Escape') { close(); if (input) input.value = ''; }
});
form?.addEventListener('submit', e => e.preventDefault());
document.addEventListener('click', e => { if (e.target instanceof Node && !form?.contains(e.target)) close(); });

// Highlight the section being read in the on-page list.
const tocLinks = [...document.querySelectorAll<HTMLAnchorElement>('.docs-toc a')];
if (tocLinks.length && 'IntersectionObserver' in window) {
  const byId = new Map(tocLinks.map(a => [decodeURIComponent(a.hash.slice(1)), a]));
  const targets = [...byId.keys()].map(id => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
  let currentId = '';
  const set = (id: string) => { if (id === currentId) return; currentId = id; tocLinks.forEach(a => a.classList.toggle('active', byId.get(id) === a)); };
  const observer = new IntersectionObserver(entries => {
    const visible = entries.filter(e => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
    if (visible[0]) set(visible[0].target.id);
  }, { rootMargin: '-80px 0px -60% 0px', threshold: 0 });
  targets.forEach(t => observer.observe(t));
  if (targets[0]) set(targets[0].id);
}
</script>
